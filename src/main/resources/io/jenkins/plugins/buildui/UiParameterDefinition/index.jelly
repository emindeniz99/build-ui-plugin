<?jelly escape-by-default='true'?>
<!--
  Rendered on "Build with Parameters" and on input step forms. The textarea is
  what the form submits; host.js hides it once the job's module has mounted and
  shows it again, with the error, if mounting fails. Form code that still waits
  for approval, or whose runtime needs eval that an administrator has not
  allowed, is never sent: the page shows the textarea and a notice.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${it.name}" description="${it.formattedDescription}">
    <div name="parameter" class="build-ui">
      <input type="hidden" name="name" value="${it.name}"/>
      <!-- "and" stops early, so blocked code is never offered for approval. -->
      <j:set var="allowed" value="${it.runtimeAllowed}"/>
      <j:set var="approved" value="${allowed and it.approved}"/>
      <j:choose>
        <j:when test="${!allowed}">
          <p class="build-ui-pending">${%The runtime of this form needs eval, which an administrator has not allowed under Manage Jenkins » System » Build UI. Enter the value as JSON.} <code>runtime: ${it.runtime}</code></p>
        </j:when>
        <j:when test="${approved}">
          <div class="build-ui-root"
               data-name="${it.name}"
               data-job="${it.jobFullName}"
               data-runtime="${it.runtime}"
               data-eval="${it.needsEval}"
               data-module="${it.moduleKey}"
               data-css="${it.cssKey}"
               data-html="${it.htmlKey}"
               data-schema="${it.schema}"
               data-sandbox="${it.sandboxed}"/>
        </j:when>
        <j:otherwise>
          <p class="build-ui-pending">${%The code of this form waits for approval by an administrator under In-process Script Approval. Until then, enter the value as JSON.}</p>
        </j:otherwise>
      </j:choose>
      <textarea name="value" class="jenkins-input build-ui-value" rows="6" spellcheck="false">${it.initialJson}</textarea>
      <j:if test="${approved}">
        <script type="module" src="${resURL}/plugin/build-ui/host.js"/>
      </j:if>
    </div>
  </f:entry>
</j:jelly>
