<?jelly escape-by-default='true'?>
<!--
  Rendered on "Build with Parameters" and on input step forms. The textarea is
  what the form submits; host.js hides it once the job's module has mounted and
  shows it again, with the error, if mounting fails.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${it.name}" description="${it.formattedDescription}">
    <div name="parameter" class="build-ui">
      <input type="hidden" name="name" value="${it.name}"/>
      <div class="build-ui-root"
           data-name="${it.name}"
           data-job="${it.jobFullName}"
           data-runtime="${it.runtime}"
           data-module="${it.moduleKey}"
           data-css="${it.cssKey}"
           data-html="${it.htmlKey}"
           data-schema="${it.schema}"/>
      <textarea name="value" class="jenkins-input build-ui-value" rows="6" spellcheck="false">${it.initialJson}</textarea>
      <script type="module" src="${resURL}/plugin/build-ui/host.js"/>
    </div>
  </f:entry>
</j:jelly>
