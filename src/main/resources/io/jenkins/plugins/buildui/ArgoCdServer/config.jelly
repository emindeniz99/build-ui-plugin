<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="${%Name}" field="name" description="${%Forms pass this as server; 'default' when they pass none.}">
    <f:textbox default="default"/>
  </f:entry>
  <f:entry title="${%URL}" field="url">
    <f:textbox checkMethod="post"/>
  </f:entry>
  <f:entry title="${%Token}" field="credentialsId" description="${%A Secret text credential with an ArgoCD API token that can read applications.}">
    <c:select/>
  </f:entry>
  <f:entry title="${%Applications}" field="apps" description="${%Glob of application names forms may read, for example web-*.}">
    <f:textbox default="*"/>
  </f:entry>
  <f:entry>
    <div align="right"><f:repeatableDeleteButton/></div>
  </f:entry>
</j:jelly>
